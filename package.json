{
  "name": "trainer-upgrades",
  "version": "0.3.0",
  "private": true,
  "description": "WoW Forever addon: marks trainer recipes that would be gear upgrades.",
  "type": "module",
  "scripts": {
    "build": "tstl -p tsconfig.json && node scripts/postbuild.mjs",
    "watch": "tstl -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node test/run.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@typescript-to-lua/language-extensions": "1.19.0",
    "fengari": "0.1.4",
    "luaparse": "0.3.1",
    "typescript": "6.0.2",
    "typescript-to-lua": "1.37.1"
  }
}
